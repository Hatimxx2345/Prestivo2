# Copie ce fichier en ".env" et remplis les valeurs avant de lancer le serveur.

# Port du serveur (Railway le définit automatiquement, laisse tel quel)
PORT=3000

# Optionnel — laisse vide si le site et le backend sont servis ensemble (cas normal ici).
# Ne sert que si un jour tu héberges le frontend séparément du backend.
FRONTEND_ORIGIN=https://prestivo.vercel.app/

# Identifiants admin du dashboard
ADMIN_EMAIL=admin@prestivo.ma

# Hash bcrypt du mot de passe admin (NE PAS mettre le mot de passe en clair).
# Un hash par défaut est fourni pour le mot de passe "changeme123" — CHANGE-LE avant la mise en prod.
# Pour générer ton propre hash : node generate-hash.js "TonNouveauMotDePasse"
ADMIN_PASSWORD_HASH=$2b$10$BYwZxEQ5hSq1i.gcq8rOkOkUNHbR/.8fsJbcGClGdhGRjq.IhiA9W

# Secret utilisé pour signer les sessions (JWT). Mets une longue chaîne aléatoire et garde-la privée.
JWT_SECRET=hatimxx234
